# Local development values only. Change the password in your private .env file.
POSTGRES_DB=quotehub
POSTGRES_USER=quotehub
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Distinct login roles; set private, URL-safe passwords for local Compose.
RUNTIME_DB_USER=quotehub_app
RUNTIME_DB_PASSWORD=
MIGRATION_DB_USER=quotehub_migrator
MIGRATION_DB_PASSWORD=
# Host directory for opt-in logical backups; use an absolute protected path in production.
QUOTEHUB_BACKUP_DIR=./backups
WEB_PORT=8000
FLASK_DEBUG=0
QUOTEHUB_ENV=development
# Generate a private value, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Blank uses 0 in development and 1 in production. Production rejects 0.
SESSION_COOKIE_SECURE=
# Keep 0 unless Gunicorn is reachable only through this many trusted proxy hops.
TRUSTED_PROXY_HOPS=0
# Local development counters are per web worker. Production requires shared Redis.
AUTH_LOGIN_RATE_LIMIT=20 per minute
AUTH_REGISTER_RATE_LIMIT=10 per hour
RATELIMIT_STORAGE_URI=memory://
# Outside Compose, set DATABASE_URL for Flask and MIGRATION_DATABASE_URL for Alembic.
# Both should use different roles. URL-encode any reserved password characters.
