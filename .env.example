# Local development values only. Change the password in your private .env file.
POSTGRES_DB=quotehub
POSTGRES_USER=quotehub
POSTGRES_PASSWORD=replace-with-a-local-development-password
WEB_PORT=8000
FLASK_DEBUG=0
# Generate a private value, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 when the app is served over HTTPS.
SESSION_COOKIE_SECURE=0
# Outside Compose, set DATABASE_URL in your shell, for example:
# DATABASE_URL=postgresql+psycopg://quotehub:your-password@localhost:5432/quotehub
